{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/workspace-action.schema.json",
  "title": "Workspace Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "created_at",
    "service",
    "operation",
    "target",
    "reason",
    "confidence",
    "risk",
    "approval",
    "evidence",
    "idempotency_key",
    "verification",
    "rollback"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 8
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "enum": [
        "notion",
        "attio",
        "gmail",
        "google_calendar",
        "slack",
        "circleback",
        "github",
        "chatgpt",
        "other"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 2
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "before": {},
    "after": {},
    "reason": {
      "type": "string",
      "minLength": 3
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "link_or_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "duplicate_check": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "clear",
            "possible_duplicate",
            "duplicate"
          ]
        },
        "matches": {
          "type": "array"
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "verification": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "expected": {}
      }
    },
    "rollback": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

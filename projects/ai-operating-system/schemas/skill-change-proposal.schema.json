{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Change Proposal",
  "type": "object",
  "required": [
    "proposal_id",
    "skill",
    "previous_rule",
    "proposed_rule",
    "evidence",
    "reason",
    "confidence",
    "risk",
    "affected_files",
    "tests",
    "rollback",
    "status"
  ],
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "previous_rule": {
      "type": "string"
    },
    "proposed_rule": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array"
    },
    "rollback": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "implemented"
      ]
    }
  }
}

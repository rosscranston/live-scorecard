{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat Route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversation_id",
    "primary_project",
    "title",
    "tags",
    "cross_links",
    "lifecycle",
    "confidence",
    "evidence"
  ],
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "primary_project": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cross_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle": {
      "enum": [
        "active",
        "one_off",
        "archive_candidate",
        "superseded",
        "archived"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_question": {
      "type": "boolean"
    }
  }
}

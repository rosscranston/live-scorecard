prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "OFFLINE_FINANCE_API_TOKEN=dev-token OFFLINE_FINANCE_PORT=8765 OFFLINE_FINANCE_DEV=1 OFFLINE_FINANCE_DATA_DIR=/Users/rossegates/Finance/finance-dashboard-codex/data uv run python -m app.main"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "VITE_API_TOKEN=dev-token VITE_API_BASE_URL=http://127.0.0.1:8765 npm run dev -- --host 127.0.0.1"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "uv run python -c $'from pathlib import Path\\nfrom collections import Counter\\nfrom app.csv_import.importers import parse_csv\\nbase=Path(\"../sample_csvs\")\\nfor p in sorted(base.glob(\"*.CSV\"))+sorted(base.glob(\"*.csv\")):\\n    parsed=parse_csv(p.read_bytes())\\n    c=Counter()\\n    for r in parsed.rows:\\n        if not r.pending and r.amount != 0:\\n            c[r.payee]+=1\\n    print(\"\\\\n##\", p.name, parsed.importer, sum(c.values()), \"rows\")\\n    for payee,n in c.most_common(25):\\n        print(f\"{n:3} {payee}\")'"], decision="allow")
prefix_rule(pattern=["kill"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["python3", "-m", "pipeline.cli", "run"], decision="allow")
prefix_rule(pattern=["pnpm", "add"], decision="allow")
prefix_rule(pattern=["mkdir", "-p"], decision="allow")
prefix_rule(pattern=["cp"], decision="allow")
